# Frontend environment variables (Next.js)
# Copy to .env.local for local development — never commit the real file.

# Base URL of the backend API (see backend/.env.example).
# Local dev default used by src/lib/config.ts if unset: http://localhost:5000
NEXT_PUBLIC_API_URL=http://localhost:5050

# Used server-side for building absolute callback/redirect URLs.
FRONTEND_URL=http://localhost:3080
NEXT_FRONTEND_API_URL=http://localhost:3080

# Optional: Google Analytics measurement ID (src/Components/GoogleAnalytics.tsx).
# Leave unset to disable analytics locally.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Optional: AI video generation service URL, if configured.
NEXT_PUBLIC_AI_VIDEO_GEN_URL=

# Canonical site URL — used for metadata (OpenGraph/canonical), robots.txt and
# sitemap.xml (src/app/layout.tsx, robots.ts, sitemap.ts). Set this to the
# real production URL once deployed (e.g. https://bloocube.vercel.app).
NEXT_PUBLIC_SITE_URL=http://localhost:3090
