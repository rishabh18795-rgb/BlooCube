generator client {
  provider = "prisma-client-js"
}

datasource db {
  // SQLite for zero-infra local dev. Swap to "postgresql" + DATABASE_URL for production.
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Role {
  CREATOR
  BRAND
  ADMIN
}

enum CampaignType {
  INFLUENCER_COLLAB
  UGC_CONTENT
  PRODUCT_LAUNCH
  BRAND_AWARENESS
  SALES_CONVERSION
}

enum CampaignStatus {
  DRAFT
  ACTIVE
  CLOSED
  COMPLETED
  CANCELLED
}

enum BiddingType {
  OPEN
  FIXED
}

enum CreatorSize {
  NANO
  MICRO
  MID
  MACRO
  MEGA
}

enum ApplicationStatus {
  SUBMITTED
  UNDER_REVIEW
  SHORTLISTED
  ACCEPTED
  REJECTED
  WITHDRAWN
  COMPLETED
}

enum PaymentStatus {
  PENDING
  INITIATED
  IN_ESCROW
  APPROVED
  RELEASED
  REFUNDED
  DISPUTED
}

enum WalletTxType {
  CREDIT
  DEBIT
  WITHDRAWAL
  REFUND
  PLATFORM_FEE
}

enum WithdrawalStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum NotificationType {
  NEW_CAMPAIGN
  NEW_APPLICATION
  APPLICATION_ACCEPTED
  APPLICATION_REJECTED
  NEW_MESSAGE
  PAYMENT_RECEIVED
  PAYMENT_RELEASED
  CAMPAIGN_DEADLINE
  CONTENT_APPROVED
  CONTENT_REVISION_REQUESTED
  WITHDRAWAL_COMPLETED
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String
  name          String
  role          Role
  isActive      Boolean   @default(true)
  isVerified    Boolean   @default(true)
  avatarUrl     String?
  phone         String?
  address       String?
  emailNotifications Boolean @default(true)
  pushNotifications  Boolean @default(true)
  smsNotifications   Boolean @default(false)
  marketingEmails    Boolean @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  creatorProfile CreatorProfile?
  brandProfile   BrandProfile?
  wallet         Wallet?

  notifications       Notification[]
  sentMessages        Message[]            @relation("MessageSender")
  conversationsAsCreator Conversation[]     @relation("ConversationCreator")
  conversationsAsBrand   Conversation[]     @relation("ConversationBrand")
  auditLogs           AuditLog[]
  passwordResetTokens PasswordResetToken[]

  @@index([role])
}

// Dedicated, single-purpose reset-token mechanism — deliberately not a JWT,
// so it can't be confused with (or forged from) an access/refresh token and
// doesn't share their signing secret. Only tokenHash (sha256 of the raw
// token mailed to the user) is stored, never the raw value, so a DB read
// alone can't be used to reset the account. usedAt is set atomically with
// the password update in the same transaction, making the token genuinely
// single-use rather than just time-limited.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model CreatorProfile {
  id               String   @id @default(cuid())
  userId           String   @unique
  user             User     @relation(fields: [userId], references: [id])
  bio              String?
  location         String?
  niches           String // comma-separated
  platforms        String // comma-separated: instagram,youtube,tiktok
  followers        Int      @default(0)
  engagementRate   Float    @default(0)
  avgReach         Int      @default(0)
  startingPrice    Int      @default(0)
  portfolio        String? // JSON array of urls
  availability     String   @default("available")
  verified         Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  applications CampaignApplication[]
  reviews      Review[]               @relation("CreatorReviews")

  @@index([niches])
  @@index([location])
}

model BrandProfile {
  id           String   @id @default(cuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id])
  companyName  String
  logoUrl      String?
  website      String?
  industry     String?
  location     String?
  description  String?
  instagram    String?
  youtube      String?
  verified     Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  campaigns Campaign[]

  @@index([industry])
}

model Category {
  id   String @id @default(cuid())
  name String @unique
  slug String @unique
}

model Campaign {
  id          String         @id @default(cuid())
  brandId     String
  brand       BrandProfile   @relation(fields: [brandId], references: [id])
  type        CampaignType   @default(INFLUENCER_COLLAB)
  title       String
  objective   String
  description String
  status      CampaignStatus @default(DRAFT)

  // Content deliverables (step 2)
  deliverables       String // JSON: {instagramReel, instagramStory, instagramPost, youtubeVideo, youtubeShort, tiktokVideo, ugcVideo}
  videoDuration       String?
  contentStyle        String? // organic | professional | raw_real | creative | tutorial | testimonial
  talkingPoints        String?
  brandMentions        String?
  requireFaceVisible   Boolean @default(false)
  requireOriginalContent Boolean @default(true)
  requireSubtitles     Boolean @default(false)
  requireProductLink   Boolean @default(false)
  contentReferences    String? // JSON array of urls
  usageRights          String  @default("organic") // organic | paid_ads | whitelisting | full_rights

  // Creator requirements (step 3)
  platforms            String // comma-separated
  categories           String // comma-separated category slugs
  locationScope         String  @default("any") // any | india | specific_cities | international
  specificCities        String?
  creatorSize           CreatorSize @default(MICRO)
  minEngagementRate     Float   @default(0)
  audienceAgeMin        Int?
  audienceAgeMax        Int?
  audienceGender        String  @default("all")
  audienceLocation      String?
  audienceInterests     String?
  requirePortfolio       Boolean @default(false)
  requireCustomProposal  Boolean @default(false)

  // Budget & bidding (step 4)
  biddingType          BiddingType @default(OPEN)
  budgetMin            Int?
  budgetMax            Int?
  creatorsRequired      Int     @default(1)
  applicationDeadline  DateTime
  startDate            DateTime?
  allowInternational   Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  applications  CampaignApplication[]
  collaborations Collaboration[]
  conversations  Conversation[]

  @@index([status])
  @@index([brandId])
}

model CampaignApplication {
  id            String             @id @default(cuid())
  campaignId    String
  campaign      Campaign           @relation(fields: [campaignId], references: [id])
  creatorId     String
  creator       CreatorProfile     @relation(fields: [creatorId], references: [id])
  bidAmount     Int
  proposal      String
  portfolioLinks String? // JSON array
  deliveryDays  Int
  message       String?
  status        ApplicationStatus  @default(SUBMITTED)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  collaboration Collaboration?
  conversation  Conversation?

  @@unique([campaignId, creatorId])
  @@index([status])
}

model Collaboration {
  id             String   @id @default(cuid())
  campaignId     String
  campaign       Campaign @relation(fields: [campaignId], references: [id])
  applicationId  String   @unique
  application    CampaignApplication @relation(fields: [applicationId], references: [id])
  amount         Int
  status         String   @default("in_progress") // in_progress | submitted | approved | completed
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  submissions ContentSubmission[]
  payment     Payment?
  review      Review?
}

model ContentSubmission {
  id              String   @id @default(cuid())
  collaborationId String
  collaboration   Collaboration @relation(fields: [collaborationId], references: [id])
  contentUrl      String
  note            String?
  status          String   @default("pending") // pending | approved | revision_requested
  createdAt       DateTime @default(now())
}

model Conversation {
  id            String   @id @default(cuid())
  campaignId    String?
  campaign      Campaign? @relation(fields: [campaignId], references: [id])
  applicationId String?  @unique
  application   CampaignApplication? @relation(fields: [applicationId], references: [id])
  creatorUserId String
  creatorUser   User     @relation("ConversationCreator", fields: [creatorUserId], references: [id])
  brandUserId   String
  brandUser     User     @relation("ConversationBrand", fields: [brandUserId], references: [id])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  messages Message[]

  @@unique([creatorUserId, brandUserId, campaignId])
}

model Message {
  id             String   @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  senderId       String
  sender         User     @relation("MessageSender", fields: [senderId], references: [id])
  body           String
  readAt         DateTime?
  createdAt      DateTime @default(now())

  @@index([conversationId])
}

model Payment {
  id              String        @id @default(cuid())
  collaborationId String        @unique
  collaboration   Collaboration @relation(fields: [collaborationId], references: [id])
  amount          Int
  platformFee     Int           @default(0)
  status          PaymentStatus @default(PENDING)
  providerRef     String?       // mock provider transaction id
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

model Wallet {
  id               String   @id @default(cuid())
  userId           String   @unique
  user             User     @relation(fields: [userId], references: [id])
  availableBalance Int      @default(0)
  pendingBalance   Int      @default(0)
  totalEarnings    Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  transactions WalletTransaction[]
  withdrawals  Withdrawal[]
}

model WalletTransaction {
  id        String       @id @default(cuid())
  walletId  String
  wallet    Wallet       @relation(fields: [walletId], references: [id])
  type      WalletTxType
  amount    Int
  note      String?
  createdAt DateTime     @default(now())

  @@index([walletId])
}

model Withdrawal {
  id         String           @id @default(cuid())
  walletId   String
  wallet     Wallet           @relation(fields: [walletId], references: [id])
  amount     Int
  method     String // upi | bank
  details    String // JSON (masked)
  status     WithdrawalStatus @default(PENDING)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
}

model Subscription {
  id        String   @id @default(cuid())
  userId    String   @unique
  plan      String   @default("free") // free | creator_pro
  priceInr  Int      @default(0)
  status    String   @default("active") // active | cancelled | expired
  startedAt DateTime @default(now())
  renewsAt  DateTime?
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id])
  type      NotificationType
  title     String
  body      String
  link      String?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([userId])
}

model Review {
  id        String   @id @default(cuid())
  collaborationId String @unique
  collaboration   Collaboration @relation(fields: [collaborationId], references: [id])
  creatorId String
  creator   CreatorProfile @relation("CreatorReviews", fields: [creatorId], references: [id])
  rating    Int
  comment   String?
  createdAt DateTime @default(now())
}

model Dispute {
  id          String   @id @default(cuid())
  reference   String // free-text link to collaboration/payment id
  raisedBy    String
  reason      String
  status      String   @default("open") // open | resolved | rejected
  resolution  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  details   String?
  createdAt DateTime @default(now())

  @@index([userId])
}

model PlatformConfig {
  key   String @id
  value String // JSON
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String?
  message   String
  createdAt DateTime @default(now())
}
