# Backend environment variables (Express API)
# Copy to .env for local development — never commit the real file.
# Local dev defaults below work out of the box with zero external infra.

# SQLite file for local dev. Swap the datasource provider in
# prisma/schema.prisma to "postgresql" and point this at a managed
# Postgres instance for production.
DATABASE_URL="file:./dev.db"

PORT=5050

# CHANGE THESE before any shared/staging/production deployment.
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d

# Must match the frontend's URL exactly (CORS allow-origin).
FRONTEND_ORIGIN=http://localhost:3080

# Set to "production" to enable Secure cookies (requires HTTPS).
NODE_ENV=development
